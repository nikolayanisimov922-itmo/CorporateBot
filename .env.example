# ==========================================================
#  Настройки корпоративного бота — ОДИН файл на весь проект.
#  Скопируйте этот файл в .env и впишите свои значения.
#  В терминале:  cp .env.example .env
#  Файл .env в git НЕ попадает (он в .gitignore) — секреты в безопасности.
# ==========================================================

# --- ЭТАП 1 (нужно сейчас) -------------------------------
# Токен бота из @BotFather (вида 7712...:AAH...)
BOT_TOKEN=

# Ваш числовой Telegram ID (узнать: напишите боту @userinfobot).
# Нужен, чтобы рассылки и админ-функции были доступны только вам.
ADMIN_ID=

# Ваш ник в Telegram (без @) — показывается в разделе «Помощь» как контакт.
SUPPORT_USERNAME=

# --- ЭТАП 4: Claude (нужно для раздела «База знаний») -----
# Ключ из console.anthropic.com (начинается на sk-ant-...)
ANTHROPIC_API_KEY=
# Эконом-модель по умолчанию. При желании: claude-sonnet-5 (сильнее, дороже).
ANTHROPIC_MODEL=claude-haiku-4-5

# --- ЭТАП 2: Notion (позже) ------------------------------
NOTION_TOKEN=
NOTION_ROOT_PAGE=
# Домен опубликованного сайта Notion — чтобы ссылки открывались у ВСЕХ.
# Возьмите из строки «This page is live on …» (без https://), напр.:
# NOTION_PUBLIC_DOMAIN=mirror-psychology-ae8.notion.site
NOTION_PUBLIC_DOMAIN=

# --- ЭТАП 6: адресные рассылки (ID через запятую) --------
# ID проджект-менеджеров и комплектаторов (узнать ID: @userinfobot).
PM_IDS=
KOMPLEKT_IDS=

# --- ЭТАП 5: как часто бот сам перечитывает Notion (минуты; 0 — выключить) ---
REFRESH_INTERVAL_MIN=60

# --- ЭТАП 7: Google Sheets -------------------------------
# Отдельная таблица под каждый тип данных. Вставьте ID таблиц (кусок ссылки
# между /d/ и /edit). Пустую строку — оставьте, если тип пока не нужен.
GOOGLE_SHEET_VYRABOTKA=
GOOGLE_SHEET_PLANY=
# Таблица для «Договорённости с клиентом» (распознавание голоса).
GOOGLE_SHEET_AGREEMENTS=
# Файл-ключ сервисного аккаунта (лежит рядом с bot.py).
GOOGLE_CREDENTIALS_FILE=google_credentials.json
# Только для ХОСТИНГА: вместо файла можно вставить всё содержимое ключа сюда
# (переменной окружения на хостинге). Локально не нужно — используется файл выше.
# GOOGLE_CREDENTIALS_JSON=
