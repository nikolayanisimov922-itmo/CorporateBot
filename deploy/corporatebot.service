# systemd-служба для запуска бота 24/7 на сервере (Hetzner, пользователь root).
# Установка:
#   cp deploy/corporatebot.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now corporatebot
# Логи:     journalctl -u corporatebot -f
# Рестарт:  systemctl restart corporatebot

[Unit]
Description=CorporateBot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/CorporateBot
ExecStart=/root/CorporateBot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
